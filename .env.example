# S3 Backend (R2 state storage)
AWS_ACCESS_KEY_ID=your_r2_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
AWS_ENDPOINT=https://your_account.r2.cloudflarestorage.com
AWS_REGION=us-east-1

# Cloudflare (R2 bucket management)
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# GCP (Artifact Registry, Cloud Run)
# Uses ADC — run: gcloud auth application-default login
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=australia-southeast1
