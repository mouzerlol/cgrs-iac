# Production environment variables
# For direnv: auto-loads this file
# For Makefile: sourced via `set -a && . environments/$(ENV)/.envrc && set +a`

# Set tofu environment
export TFENV=prod

# AWS/R2 Configuration (S3-compatible API for state storage backend)
export AWS_ENDPOINT="https://645022b5181fa9285795e4936ee2b30a.r2.cloudflarestorage.com"
export AWS_REGION="us-east-1"
export AWS_ACCESS_KEY_ID="c42d2c13b89face477a29a8d79fa1f97"
export AWS_SECRET_ACCESS_KEY="2663842f9899e9e1b2cabe173ea4728cb69dcbb00f8be222e9caef7743cb9615"

# Cloudflare Configuration (for R2 bucket management via api.cloudflare.com)
# Account ID = segment in https://dash.cloudflare.com/<ACCOUNT_ID>/ (Workers overview, or Account home).
# It is NOT the same value as R2 S3 "Access Key ID" (AWS_ACCESS_KEY_ID above).
export CLOUDFLARE_ACCOUNT_ID="645022b5181fa9285795e4936ee2b30a"
export CLOUDFLARE_API_TOKEN="cfat_WcK80aIajXHYrvcVV2O5FXUxrPnpdRUTzHVf6XXk41516fc2"

# Terraform variables
export TF_VAR_environment="prod"
export TF_VAR_aws_access_key_id="$AWS_ACCESS_KEY_ID"
export TF_VAR_aws_secret_access_key="$AWS_SECRET_ACCESS_KEY"
export TF_VAR_aws_endpoint="$AWS_ENDPOINT"
export TF_VAR_aws_region="$AWS_REGION"
export TF_VAR_cloudflare_account_id="$CLOUDFLARE_ACCOUNT_ID"
export TF_VAR_cloudflare_api_token="$CLOUDFLARE_API_TOKEN"